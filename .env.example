# Copy to .env and fill in real values. .env is gitignored -- never commit real credentials.
# Loaded automatically by src/hosts/cli.ts (Node's native process.loadEnvFile) -- no
# shell-profile export needed once this file exists.
#
# For a real Jira-backed target project, /tai-init's guided checklist (TAI-116/130,
# docs/target-project-setup-checklist.md) generates this file for you via
# `cli.ts init env`, once the Jira/Confluence/Bitbucket admin steps it walks through are
# done -- you don't have to hand-fill every value below yourself.

# --- Required for both backends ---
TAI_PROJECT_KEY=TAI
# TAI_ROOT=.tai                    # optional, defaults to .tai
# TAI_BACKEND=filesystem           # optional, defaults to filesystem; set to "jira" for the real backend

# --- Grooming (TAI-389/395) ---
# TAI_STALE_BACKLOG_DAYS=60        # optional, default 60: a Backlog ticket untouched this long shows up in /tai-groom's stale section

# --- Assignee suggestions (TAI-416/419) ---
# TAI_AREA_WINDOW_DAYS=90          # optional, default 90: how far back "closed tickets under the same Component/labels" counts as area knowledge

# --- Recorded local check (TAI-534) ---
# TAI_CHECK_COMMAND=npm run typecheck && npm run lint && npm test   # optional: the command that verifies a commit. When set, `git-pr check` runs it on a PR's head commit and records the result, and `git-pr merge` requires a result on the PR's current commit. The command runs without TAI's own settings (no TAI_* or BITBUCKET_* variable reaches it)

# --- Project context (TAI-470) ---
# TAI_PROJECT_CONTEXT_FILE=project-context.md   # optional, default project-context.md at the repo root: this project's own rules (commands, stack, conventions, never-dos), printed in front of every persona
# TAI_PROJECT_CONTEXT_BUDGET=6000               # optional, default 6000: how many characters of that file are printed; the rest is named, not shown

# --- Work briefing (TAI-464) ---
# TAI_BRIEFING_BUDGET=60000        # optional, default 60000: size of a /tai-work briefing in characters; linked pages and tickets are cut to fit, the subtask and parent never are

# --- Jira backend (TAI_BACKEND=jira) ---
# TAI_SPACE_KEY=TAI
# TAI_JIRA_SITE_URL=https://your-site.atlassian.net
# TAI_JIRA_EMAIL=you@example.com
# TAI_JIRA_API_TOKEN=

# --- Filesystem backend (TAI_BACKEND=filesystem, the default) ---
# TAI_HUMAN_ID=you@example.com
# TAI_HUMAN_NAME=Your Name
# TAI_HUMAN_EMAIL=you@example.com

# --- Which git host (TAI-583) ---
# bitbucket or github. Written by `init run` from origin's remote. When unset, TAI reads origin's
# remote at run time, and falls back to Bitbucket.
# TAI_GIT_HOST=github

# --- GitHub (only needed for `git-pr` on a GitHub project, TAI-583) ---
# The standard name, shared with the gh CLI and the GitHub MCP server. A fine-grained token on the
# project's repositories with: Pull requests, Contents and Commit statuses read/write; Actions and
# Metadata read. (Fine-grained tokens cannot read check runs, so CI results come from the GitHub
# Actions runs; a classic token with the repo scope also works, and reads check runs directly.) Your email for the "PR Reviewers" page comes from TAI_JIRA_EMAIL (a GitHub token
# carries none), and each reviewer's GitHub login comes from that page's GitHub column.
# GITHUB_TOKEN=

# Optional (TAI-583 ADR decision 1): for a one-person GitHub project. GitHub refuses an approval
# from a PR's own author; with this set, the author's `git-pr review approve` posts a stamped
# self-review that the merge gate counts as one approval. Off by default; no effect on Bitbucket.
# TAI_PR_SELF_REVIEW=true

# --- Bitbucket (only needed for `git-pr create|review|merge`, TAI-73) ---
# Deliberately unprefixed (TAI-346, found live 2026-09-23), unlike every other var above --
# not a code dependency (cli.ts reads these as plain lookups it fully controls), but a
# separately-configured Bitbucket MCP server (if you use one) typically expects exactly
# these bare names too, so matching them means one name to remember per credential across
# both systems instead of two. If you don't use a Bitbucket MCP server, this doesn't apply
# to you -- it's a convenience convention, not a requirement.
# BITBUCKET_EMAIL=you@example.com
# BITBUCKET_API_TOKEN=

# --- Approved-PR-merge surfacing in `tai_ready` (TAI-106/107/108) ---
# Comma-separated workspace/repo (or owner/repo) entries. Also needs the git host's credentials
# above (GITHUB_TOKEN, or BITBUCKET_EMAIL/BITBUCKET_API_TOKEN), or the PR-awareness path is silently skipped.
# TAI_GIT_REPOS=dmayhak/tai-framework

# Optional (TAI-462): how many approvals a PR needs before `git-pr merge` will merge it and before
# it shows under "ready to merge". Only approvals cast on the PR's current commit count.
# TAI_PR_REQUIRED_APPROVALS=1

# Optional companion (TAI-162/TAI-163 ADR): auto-discovers every repo in a workspace (on GitHub, an organization or user)
# instead of hand-maintaining TAI_GIT_REPOS. Coexists ADDITIVELY -- set alone, scans the
# whole workspace; set together with TAI_GIT_REPOS, the discovered list is narrowed down
# to that explicit subset instead of being replaced by it.
# TAI_GIT_WORKSPACE=dmayhak
